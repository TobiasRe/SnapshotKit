<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The keys build settings can't set; Xcode generates the rest (GENERATE_INFOPLIST_FILE). -->
<plist version="1.0">
<dict>
	<!-- The app is in English: without this, dates and numbers came out in the system's language
	     ("17. Okt. 2026" in an English sentence). The user's region still sets their order. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
	</array>
	<!-- snapshotkit://compare?reference=…&actual=…, from `snapkit open` (the diff tool) or a link. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>org.snapshotkit.SnapshotKit.compare</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>snapshotkit</string>
			</array>
		</dict>
	</array>
	<!-- Open in SnapshotKit: the snapshots of the test or test file whose name is selected (ServiceProvider).
	     In the Services menu of any app, and in Xcode's editor context menu under Services. An empty
	     NSRequiredContext turns it on without a trip to System Settings. -->
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Open in SnapshotKit</string>
			</dict>
			<key>NSMessage</key>
			<string>openInSnapshotKit</string>
			<key>NSPortName</key>
			<string>SnapshotKit</string>
			<key>NSSendTypes</key>
			<array>
				<string>public.utf8-plain-text</string>
			</array>
			<key>NSRequiredContext</key>
			<dict/>
		</dict>
	</array>
</dict>
</plist>
