<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The keys build settings can't set; Xcode generates the rest (GENERATE_INFOPLIST_FILE). -->
<plist version="1.0">
<dict>
	<!-- The app is in English: without this, dates and numbers came out in the system's language
	     ("17. Okt. 2026" in an English sentence). The user's region still sets their order. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
	</array>
	<!-- Asked once, when Xcode's editor extension first sends a test: which project Xcode has open. -->
	<key>NSAppleEventsUsageDescription</key>
	<string>SnapshotKit asks Xcode which project is open, to show or re-record the test at your cursor.</string>
	<!-- snapshotkit://compare?reference=…&actual=…, from `snapkit open` (the diff tool) or a link;
	     snapshotkit://test?…, from Xcode's editor extension. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>org.snapshotkit.SnapshotKit.compare</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>snapshotkit</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
