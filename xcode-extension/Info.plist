<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The keys build settings can't set; Xcode generates the rest (GENERATE_INFOPLIST_FILE). -->
<plist version="1.0">
<dict>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
	</array>
	<!-- Xcode lists the commands under Editor › SnapshotKit, by the extension's display name. -->
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.dt.Xcode.extension.source-editor</string>
		<key>NSExtensionAttributes</key>
		<dict>
			<key>XCSourceEditorExtensionPrincipalClass</key>
			<string>$(PRODUCT_MODULE_NAME).SourceEditorExtension</string>
			<key>XCSourceEditorCommandDefinitions</key>
			<array>
				<dict>
					<key>XCSourceEditorCommandIdentifier</key>
					<string>$(PRODUCT_BUNDLE_IDENTIFIER).show</string>
					<key>XCSourceEditorCommandName</key>
					<string>Show Test</string>
					<key>XCSourceEditorCommandClassName</key>
					<string>$(PRODUCT_MODULE_NAME).TestCommand</string>
				</dict>
				<dict>
					<key>XCSourceEditorCommandIdentifier</key>
					<string>$(PRODUCT_BUNDLE_IDENTIFIER).rerecord</string>
					<key>XCSourceEditorCommandName</key>
					<string>Re-record Test</string>
					<key>XCSourceEditorCommandClassName</key>
					<string>$(PRODUCT_MODULE_NAME).TestCommand</string>
				</dict>
			</array>
		</dict>
	</dict>
</dict>
</plist>
